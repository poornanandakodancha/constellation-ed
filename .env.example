# ConstellationEd Environment Configuration

# Optional: LLM API Key (Google Gemini or OpenAI compatible)
# The application features a 100% deterministic fallback question bank and misconception
# detector in /data, allowing all features and demo mode to operate flawlessly offline.
GEMINI_API_KEY=""
# or OPENAI_API_KEY=""
LLM_PROVIDER="gemini" # or "openai" or "mock"

# Node Environment
NODE_ENV="development"
